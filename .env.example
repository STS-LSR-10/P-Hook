# Copy to .env.local for development. Never commit real values.
# In production, set every secret in Cloudflare (Workers > phook > Settings > Variables and Secrets).

# LINE Messaging API / Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=
# Channel ID of the LINE Login channel that owns the LIFF app (used to verify ID tokens).
# Leave empty only if LIFF is attached to the same channel as LINE_CHANNEL_ID.
LINE_LOGIN_CHANNEL_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# OCR / categorizer LLM — choose ONE provider: gemini | anthropic | openai
# Only the selected provider's key is required.
AI_PROVIDER=gemini
# Optional: override the provider's default model
AI_MODEL=
# Slip reading order: EasySlip first (exact, detects fake slips; transfer slips with a QR only),
# then the AI models. Keys that are empty are skipped. Optional override of the order:
#   SLIP_READERS=easyslip,gemini,anthropic,openai
EASYSLIP_API_KEY=
SLIP_READERS=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App security
SESSION_JWT_SECRET=
CRON_SECRET=

# Contact shown on the Privacy Policy / Terms pages (email or LINE OA id)
NEXT_PUBLIC_CONTACT_EMAIL=

# Public base URL, e.g. https://app.p-hook.com
APP_BASE_URL=

# Stripe payments (optional: while either is empty the upgrade button says "not open yet").
# Use the TEST keys (sk_test_..., whsec_... from a test-mode webhook) until everything works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
