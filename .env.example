# Copy to .env.local for development. Never commit real values.
# In production, set every secret in Cloudflare (Workers > phook > Settings > Variables and Secrets).

# LINE Messaging API / Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
NEXT_PUBLIC_LIFF_ID=
# Channel ID of the LINE Login channel that owns the LIFF app (used to verify ID tokens).
# Leave empty only if LIFF is attached to the same channel as LINE_CHANNEL_ID.
LINE_LOGIN_CHANNEL_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# OCR / categorizer LLM — choose ONE provider: gemini | anthropic | openai
# Only the selected provider's key is required.
AI_PROVIDER=gemini
# Optional: override the provider's default model
AI_MODEL=
# Slip reading order: EasySlip first (exact, detects fake slips; transfer slips with a QR only),
# then the AI models. Keys that are empty are skipped. Optional override of the order:
#   SLIP_READERS=easyslip,gemini,anthropic,openai
EASYSLIP_API_KEY=
SLIP_READERS=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App security
SESSION_JWT_SECRET=
# While replacing SESSION_JWT_SECRET: put the old one here for an hour or two (still accepted, never
# used to sign), then remove it. Leave empty otherwise. The "add to calendar" buttons on group
# reminder cards never expire: removing it makes the ones already posted stop working.
SESSION_JWT_SECRET_PREVIOUS=
CRON_SECRET=

# Contact shown on the Privacy Policy / Terms pages (email or LINE OA id)
NEXT_PUBLIC_CONTACT_EMAIL=

# Public base URL, e.g. https://app.p-hook.com
APP_BASE_URL=

# Stripe payments (optional: while either is empty the upgrade button says "not open yet").
# Use the TEST keys (sk_test_..., whsec_... from a test-mode webhook) until everything works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard (/admin) — protected by Cloudflare Access. Closed to everyone until both are set.
# Team domain: Zero Trust > Settings > Custom Pages (e.g. myteam.cloudflareaccess.com)
# AUD tag: Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional, default admin@p-hook.com
ADMIN_EMAIL=

# Admin dashboard costs (all optional)
# R2 Class A/B operations: account id + an API token with "Account Analytics: Read"
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
# Baht per USD when the ECB rate cannot be fetched, e.g. 32.5
USD_THB_RATE=
# LINE OA plan when it cannot be told from the quota: free | basic | pro
LINE_OA_PLAN=
# Extra AI model prices, USD per 1M tokens: {"claude-haiku-5-5":{"input":1,"output":5}}
AI_PRICES=
# Fixed monthly plans in USD (defaults: Workers Paid 5, Supabase Free 0; Supabase Pro = 25)
WORKERS_PLAN_USD=
SUPABASE_PLAN_USD=
